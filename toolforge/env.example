# Copy to ~/www/python/src/.env on the tool account and fill in the blanks.
# That file is gitignored. Do not commit the real values.

DOMAIN=wdaudiolex-api.toolforge.org
PREFIX=/api
IS_DEV=false
APP_VERSION=0.1.0
# python3 -c 'import secrets; print(secrets.token_hex(32))'
APP_SECRET=
TOOL_CONTACT=https://wdaudiolex-api.toolforge.org

# Build the URI on Toolforge (see toolforge/README.md). Password must be
# URL-encoded. Database name is the credential user, two underscores, then
# wdaudiolex. Example shape, not a real password:
# mysql+pymysql://sNNNNN:secret@tools.db.svc.wikimedia.cloud/sNNNNN__wdaudiolex?charset=utf8mb4
SQLALCHEMY_DATABASE_URI=

OAUTH_BASE_URL=https://www.wikidata.org
BASE_URL=https://www.wikidata.org/w/api.php
WM_COMMONS_URL=https://commons.wikimedia.org/w/api.php
SPARQL_ENDPOINT_URL=https://query.wikidata.org/sparql
WM_COMMONS_IMAGE_BASE_URL=https://commons.wikimedia.org/wiki/Special:FilePath/
WM_COMMONS_AUDIO_BASE_URL=https://upload.wikimedia.org/wikipedia/commons/

# Wikidata OAuth consumer (Special:OAuthConsumerRegistration).
CONSUMER_KEY=
CONSUMER_SECRET=

DEV_FE_URL=http://localhost:3000
PROD_FE_URL=
